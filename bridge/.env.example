# ── MQTT broker (HiveMQ Cloud Serverless — ADR 0003) ─────────────────────────
MQTT_BROKER=your-cluster.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=rempah-bridge
MQTT_PASSWORD=changeme

# ── Supabase (service_role key bypasses RLS) ─────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>

# ── Bridge tuning (optional — defaults shown) ─────────────────────────────────
OVER_TEMP_THRESHOLD_C=100.0   # °C above which over-temperature alert fires
OFFLINE_AFTER_S=60.0          # seconds of silence before device is flagged offline
DRIP_ML=0.05                  # mL per drip pulse (calibrate per still)
YIELD_RATIO_L_PER_KG=0.01     # target yield per kg Charge Mass (e.g. 10 mL/kg)
COMMAND_POLL_S=2.0             # how often to poll Supabase for pending commands
OFFLINE_CHECK_S=30.0           # how often to run the offline-detection sweep
PURGE_INTERVAL_S=86400         # how often to purge expired sensor_logs (1 day)

# Root topic MQTT — semua topic dibangun dari ini:
#   {MQTT_TOPIC_ROOT}/{device_id}/telemetry|state|command
MQTT_TOPIC_ROOT=rempah
