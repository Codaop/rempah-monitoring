# Dashboard environment template
# Salin ke dashboard/.env lalu isi nilainya — dashboard/.env gitignored.

# --- Supabase ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Link reset password di email (tanpa ini fallback ke window.location.origin)
VITE_SITE_URL=https://<domain-vercel>

# --- MQTT WebSocket (jalur live metric cards, ticket 01-04) ---
# Broker HiveMQ Cloud: port WSS default 8884, path /mqtt (verifikasi di console)
VITE_MQTT_URL=wss://<cluster-url>:8884/mqtt
# Kredensial sama dengan device (satu credential bersama) — lihat docs/ops.md
VITE_MQTT_USERNAME=rempah_hivemq
VITE_MQTT_PASSWORD=<password>
