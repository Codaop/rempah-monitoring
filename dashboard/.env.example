# Dashboard environment (salinn ke .env lalu isi nilai sebenarnya).
# Semua file .env gitignored — jangan commit nilai asli.

# Supabase (project REMPAH)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kredensial MQTT bersama (shared credential) — satu username/password untuk
# semua device (keputusan tim, ticket 39). Dipakai kartu flash provisioning.
# Kosongkan hanya jika kartu flash harus menampilkan "hubungi admin".
VITE_MQTT_DEVICE_USERNAME=
VITE_MQTT_DEVICE_PASSWORD=
