# Salin file ini ke .env dan isi dengan nilai asli dari proyek Supabase REM-PAH.
# File .env TIDAK boleh di-commit ke git (sudah ada di .gitignore).
#
# Cara mendapatkan nilai-nilai ini:
#   1. Buka https://app.supabase.com → proyek REM-PAH
#   2. Settings → API
#   3. Salin "Project URL" dan "anon public" key

VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
